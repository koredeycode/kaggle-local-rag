# Copy to `.env` for local runs. On Kaggle the notebook CONFIG cell (cell 1) is
# the single source of truth; env vars are a convenience for the CLI/scripts.
#
# §16: RAGLAB_RUNTIME_TOKEN is deliberately absent. The runtime token is printed
# once to the operator by notebook cell 27 and never persisted. Setting it here
# would contradict that rule, so config.py refuses to read it from .env.

# mock | tiny | local  (§8). mock is the default and needs no GPU download.
RAGLAB_PROFILE=mock

# Storage root. §6.3 on Kaggle; the repo-local default keeps dev runs off /kaggle.
RAGLAB_STORE_ROOT=./ragstore

# §5.5 — switch to float32 if fp16 embedding agreement measures poorly.
RAGLAB_VECTOR_DTYPE=float16

# GPU 1 is the retrieval worker; Ollama owns GPU 0 (§4).
RAGLAB_EMBED_DEVICE=cpu
RAGLAB_RERANK_DEVICE=cpu

# §8 retrieval knobs.
RAGLAB_RETRIEVE_TOP_K=40
RAGLAB_CONTEXT_TOP_N=6
RAGLAB_GATE_ENABLED=true
